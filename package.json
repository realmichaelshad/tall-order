{
  "name": "tall-order",
  "version": "1.0.0",
  "description": "Type a few lines and a wood type show poster sets itself, then pull it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "perf": "node scripts/perf.mjs"
  },
